# Supabase PostgreSQL connection. Use a separate development database locally.
DATABASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BASE_PATH=/

# Supabase Storage credentials. Keep the service-role key server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=zieit-media

# Local-only account creation; leave false in production.
ALLOW_LOCAL_TEST_ACCOUNTS=false
